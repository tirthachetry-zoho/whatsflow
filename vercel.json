{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "prisma generate && next build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "regions": ["iad1"],
  "functions": {
    "src/app/api/webhooks/openwa/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/test/webhook-simulate/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/test/webhook-raw/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/demo/simulate/route.ts": {
      "maxDuration": 30
    }
  }
}
