# ─────────────────────────────────────────────────────────────
# Freebuff Desktop — Environment Variables
# Copy this file to `.env` and fill in the values.
# Never commit `.env`.
# ─────────────────────────────────────────────────────────────

# ─── Database (PostgreSQL) ───
# For Vercel: Use Vercel Postgres, Neon, Supabase, or Railway
# The DIRECT_URL is optional — only needed for Prisma migrations (not queries)
DATABASE_URL="postgresql://user:password@localhost:5432/freebuff?schema=public"
DIRECT_URL=""

# ─── Authentication ───
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# ─── App ───
# Your production URL (set this in Vercel Environment Variables)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── OpenWA (Self-hosted WhatsApp API Gateway) ───
# The base URL of your running OpenWA instance
OPENWA_BASE_URL="http://localhost:2785"
# API key created in the OpenWA dashboard
OPENWA_API_KEY=""
# Default session ID to use when sending messages
OPENWA_SESSION_ID="default"
# Webhook HMAC secret (set this in OpenWA webhook config too)
# Recommended for production — prevents unauthorized webhook calls
OPENWA_WEBHOOK_SECRET=""

# ─── AI (OpenAI-compatible — swap via AI_BASE_URL) ───
# Leave AI_API_KEY empty to run in offline/demo mode using the
# built-in deterministic intent classifier.
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

# ─── Rate Limiting (optional) ───
# For production, use Upstash Redis for distributed rate limiting
# Without this, rate limiting is per-serverless-instance (still works, just not shared)
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# ─── Background Jobs (optional) ───
# "inline" runs jobs in the same request (default, works on Vercel)
# Other options: "cron", "inngest", "trigger_dev"
JOB_BACKEND="inline"
