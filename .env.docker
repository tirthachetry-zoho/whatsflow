# ── Freebuff + OpenWA Docker Stack ──
# Copy this to .env and customize

# Database (uses built-in PostgreSQL by default)
DATABASE_URL="postgresql://freebuff:freebuff@postgres:5432/freebuff?schema=public"

# App
AUTH_SECRET="change-me-to-a-random-string"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# OpenWA
OPENWA_API_KEY="freebuff-admin-key"
OPENWA_SESSION_ID="default"
OPENWA_WEBHOOK_SECRET=""

# AI (optional — leave empty for offline mode)
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
